@model List<ProyectoLoginMVC.Models.UserListItem>
@{
    Layout = null;
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eliminar usuarios | TechFlow</title>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
<main class="content management">
    <a class="action-link" asp-controller="Home" asp-action="Dashboard">← Volver al panel</a>
    <h1>Eliminar usuarios</h1>
    <p>Selecciona una cuenta para revisar y confirmar su eliminación. Las cuentas de administrador están protegidas.</p>
    @if (TempData["Success"] is string success) { <p class="notice" role="status">@success</p> }
    @if (TempData["Error"] is string error) { <p class="notice error" role="alert">@error</p> }
    <div asp-validation-summary="All" role="alert"></div>
    <div class="table-container">
    <table>
        <thead><tr><th scope="col">Usuario</th><th scope="col">Nombre</th><th scope="col">Rol</th><th scope="col">Puesto</th><th scope="col">Acción</th></tr></thead>
        <tbody>
        @foreach (var usuario in Model)
        {
            <tr><td>@usuario.Username</td><td>@usuario.Nombre</td><td>@usuario.Rol</td><td>@usuario.Puesto</td><td>
            @if (usuario.Rol != "Administrador")
            { <a class="danger-link" asp-action="Delete" asp-route-id="@usuario.IdUsuario">Eliminar</a> }
            else { <span>Cuenta protegida</span> }
            </td></tr>
        }
        </tbody>
    </table>
    </div>
    @if (Model.Count == 0 && ViewData.ModelState.IsValid) { <p>No hay usuarios registrados.</p> }
</main>
</body>
</html>
